{
  "name": "@seba174/ng2-pdf-viewer",
  "version": "22.0.0",
  "description": "Angular 22+ standalone component for rendering PDF",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "build:stats": "ng build --stats-json",
    "watch": "ng build --watch --configuration development",
    "analyze": "esbuild-visualizer --metadata dist/stats.json --filename dist/analysis.html",
    "test": "ng test --watch false",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCustom",
    "test:w": "ng test",
    "lint": "ng lint",
    "packagr": "ng-packagr -p ng-package.json -c tsconfig.packagr.json"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seba174/ng2-pdf-viewer.git"
  },
  "keywords": [
    "angular",
    "pdf",
    "pdf-viewer",
    "angular-pdf",
    "angular22",
    "pdfjs",
    "pdfjs-dist"
  ],
  "author": "seba174",
  "bugs": {
    "url": "https://github.com/seba174/ng2-pdf-viewer/issues"
  },
  "homepage": "https://github.com/seba174/ng2-pdf-viewer#readme",
  "schematics": "./schematics/collection.json",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "pdfjs-dist": "^6.0.227",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/core": ">=22.0.0",
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/cli": "~22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/language-service": "22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^25.9.2",
    "angular-eslint": "22.0.0",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^10.4.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "ng-packagr": "^22.0.0",
    "rxjs": "~7.8.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
